// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id               String   @id @default(uuid())
  name             String
  marketingConsent Boolean  @default(false)
  source           String? // web_form, sms_opt_in, manual, etc.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leadStatus LeadStatus @default(NEW)

  // UTM Tracking fields
  utmSource   String? // google, facebook, linkedin, newsletter
  utmMedium   String? // cpc, email, social, organic
  utmCampaign String? // campaign name
  utmTerm     String? // paid search keyword
  utmContent  String? // ad variation / A-B test
  referrer    String? // original referrer URL
  landingPage String? // first page visited

  // Relaciones
  emails   ContactEmail[]
  phones   ContactPhone[]
  projects Project[]

  @@index([leadStatus])
  @@index([source])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
}

model ContactEmail {
  id        String  @id @default(uuid())
  contactId String
  email     String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model ContactPhone {
  id        String  @id @default(uuid())
  contactId String
  phone     String  @unique
  type      String? // mobile, home, work, etc.
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

// One row per allowed request; src/lib/rateLimit.ts counts rows per key
// inside a time window. Old rows are pruned by the limiter itself.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model EmailCampaign {
  id              String             @id @default(uuid())
  name            String
  subject         String
  htmlContent     String             @db.Text
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  completedAt     DateTime?
  emailsSent      Int                @default(0) // Total de emails enviados hasta ahora
  totalEmails     Int                @default(0) // Total de emails a enviar
  status          String             @default("pending") // pending, in_progress, completed, failed, sending
  lastBatchSentAt DateTime? // Última vez que se envió un lote
  emailLogs       CampaignEmailLog[]

  @@index([status])
}

model CampaignEmailLog {
  id           String        @id @default(uuid())
  campaignId   String
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailAddress String
  contactName  String
  sentAt       DateTime      @default(now())
  resendId     String?
  status       String        @default("sent") // sent, failed, bounced
  errorMessage String?

  @@index([campaignId])
  @@index([emailAddress])
  @@index([status])
}

model DailyEmailQuota {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  emailsSent Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model SmsCampaign {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  smsSent   Int       @default(0) // Total de SMS enviados en esta campaña
}

// One row per sold project (50/50 plan). The customer is not a user: they
// reach it through /project/{accessToken} and /pay/{accessToken}.
model Project {
  id          String @id @default(uuid())
  projectCode String @unique // 6 uppercase chars generated by the app (generateProjectCode)
  accessToken String @unique @default(uuid()) // Secret token for customer URLs
  email       String
  name        String
  planName    String
  totalAmount Int // Total in cents

  status ProjectStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments        Payment[]
  invoices        Invoice[]
  milestones      Milestone[]
  termsAcceptance TermsAcceptance?

  // Revenue attribution: link to the original lead
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@index([email])
  @@index([status])
  @@index([contactId])
}

// One row per charge of a project: the deposit and the final payment.
model Payment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind   PaymentKind
  amount Int // In cents
  status PaymentStatus @default(pending)

  stripeSessionId String?   @unique // Checkout Session that paid this charge
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, kind])
  @@index([status])
  @@index([paidAt])
}

model TermsAcceptance {
  id             String   @id @default(cuid())
  userId         String?
  projectId      String?  @unique // 50/50 projects
  subscriptionId String?  @unique // subscriptions
  plan           String?
  acceptedAt     DateTime
  ipAddress      String?
  userAgent      String?
  termsVersion   String

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String @id @default(uuid())
  stripeSubscriptionId String @unique
  stripeCustomerId     String
  email                String
  name                 String
  planName             String
  amount               Int // Amount in cents ($200 = 20000)
  currency             String @default("USD")

  // Status
  status SubscriptionStatus @default(active)

  // Billing cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Cancellation
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  // Stripe session/checkout info
  stripeSessionId String?

  // Magic link to the Stripe Customer Portal (/manage-subscription/[token]).
  // Regenerated on every request; the Stripe session is created on click.
  portalToken          String?   @unique
  portalTokenExpiresAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  termsAcceptance TermsAcceptance?

  @@index([email])
  @@index([stripeCustomerId])
  @@index([status])
}

model SmsLog {
  id          String   @id @default(uuid())
  phoneNumber String
  message     String   @db.Text
  direction   String // received, sent
  command     String? // START, STOP, HELP, etc.
  status      String? // queued, sent, delivered, failed
  twilioSid   String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([direction])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROPOSAL_SENT
  WON
  LOST
}

enum ProjectStatus {
  pending
  in_progress
  ready_for_payment
  completed
}

enum PaymentKind {
  deposit
  final
}

enum PaymentStatus {
  pending
  paid
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  unpaid
}

enum InvoiceType {
  initial
  final
  summary
}

enum InvoiceStatus {
  paid
  pending
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
}

// Project Milestones for tracking detailed progress
model Milestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String // "Design Mockups", "Frontend Development", etc.
  description String?         @db.Text
  order       Int             @default(0) // For sorting milestones
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([order])
}

model Invoice {
  id            String  @id @default(uuid())
  invoiceNumber String  @unique // "INV-2025-001"
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type InvoiceType

  // Datos del cliente (snapshot histórico)
  customerName  String
  customerEmail String
  projectCode   String // Denormalizado para fácil búsqueda
  planName      String

  // Detalles financieros (en centavos)
  description String @db.Text
  subtotal    Int // Subtotal en centavos
  taxRate     Float  @default(0) // Porcentaje de impuestos (ej: 8.5 para 8.5%)
  taxAmount   Int    @default(0) // Monto de impuestos en centavos
  total       Int // Total final en centavos (subtotal + tax)
  currency    String @default("USD")

  // Almacenamiento del PDF
  pdfUrl     String? // URL en Vercel Blob
  pdfBlobKey String? // Key para eliminar de Vercel Blob si es necesario

  // Metadata de Stripe
  stripeSessionId String?

  // Status y fechas
  status    InvoiceStatus @default(paid)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  paidDate  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([customerEmail])
  @@index([projectCode])
  @@index([status])
  @@index([issueDate])
}
