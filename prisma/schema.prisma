// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id               String   @id @default(uuid())
  name             String
  marketingConsent Boolean  @default(false)
  source           String? // web_form, sms_opt_in, manual, etc.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leadStatus LeadStatus @default(NEW)

  // What the lead asked for on the contact form and how they want to be reached
  serviceInterest  String? // Offer id from the catalogue (src/lib/offerIds.ts)
  preferredChannel ContactChannel?

  // UTM Tracking fields
  utmSource   String? // google, facebook, linkedin, newsletter
  utmMedium   String? // cpc, email, social, organic
  utmCampaign String? // campaign name
  utmTerm     String? // paid search keyword
  utmContent  String? // ad variation / A-B test
  referrer    String? // original referrer URL
  landingPage String? // first page visited

  // Relaciones
  emails   ContactEmail[]
  phones   ContactPhone[]
  projects Project[]
  quotes   Quote[]

  @@index([leadStatus])
  @@index([source])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
}

model ContactEmail {
  id        String  @id @default(uuid())
  contactId String
  email     String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model ContactPhone {
  id        String  @id @default(uuid())
  contactId String
  phone     String  @unique
  type      String? // mobile, home, work, etc.
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

// One row per allowed request; src/lib/rateLimit.ts counts rows per key
// inside a time window. Old rows are pruned by the limiter itself.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model EmailCampaign {
  id              String             @id @default(uuid())
  name            String
  subject         String
  htmlContent     String             @db.Text
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  completedAt     DateTime?
  emailsSent      Int                @default(0) // Total de emails enviados hasta ahora
  totalEmails     Int                @default(0) // Total de emails a enviar
  status          String             @default("pending") // pending, in_progress, completed, failed, sending
  lastBatchSentAt DateTime? // Última vez que se envió un lote
  emailLogs       CampaignEmailLog[]

  @@index([status])
}

model CampaignEmailLog {
  id           String        @id @default(uuid())
  campaignId   String
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailAddress String
  contactName  String
  sentAt       DateTime      @default(now())
  resendId     String?
  status       String        @default("sent") // sent, failed, bounced
  errorMessage String?

  @@index([campaignId])
  @@index([emailAddress])
  @@index([status])
}

model DailyEmailQuota {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  emailsSent Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model SmsCampaign {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  smsSent   Int       @default(0) // Total de SMS enviados en esta campaña
}

// One row per sold project (50/50 plan). The customer is not a user: they
// reach it through /project/{accessToken} and /pay/{accessToken}.
model Project {
  id          String @id @default(uuid())
  projectCode String @unique // 6 uppercase chars generated by the app (generateProjectCode)
  accessToken String @unique @default(uuid()) // Secret token for customer URLs
  email       String
  name        String
  planName    String
  totalAmount Int // Total in cents

  status ProjectStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments        Payment[]
  invoices        Invoice[]
  milestones      Milestone[]
  termsAcceptance TermsAcceptance?

  // Revenue attribution: link to the original lead
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Set when the project was sold through a written quote (/quote/{token})
  quote Quote?

  @@index([email])
  @@index([status])
  @@index([contactId])
}

// A written quote for a scoped project ("Get a Quote" offers or anything
// custom). The admin creates it after the scoping call and sends the customer
// a link to /quote/{token}, where they read the scope, accept the terms and
// pay the 50 % deposit. The Stripe webhook turns an accepted quote into the
// Project (it stays the only creator of Project rows). "Expired" is not a
// status: a sent quote is expired once expiresAt has passed.
model Quote {
  id          String @id @default(uuid())
  quoteNumber String @unique // "Q-2026-001" (generateQuoteNumber)
  token       String @unique @default(uuid()) // Secret token for /quote/{token}

  // Customer snapshot; email is lowercased and becomes Project.email
  email String
  name  String

  // Which catalogue offer it is based on (src/lib/offerIds.ts); null for a custom quote
  offerId  String?
  // Product name on the Stripe session, the invoices and Project.planName
  planName String
  // What is included, one item per entry; shown on the quote page and the email
  scope    String[]
  // Free text for the customer (timeline, assumptions, exclusions)
  notes    String?  @db.Text

  totalAmount Int // Total in cents; the deposit is 50 % of it

  status QuoteStatus @default(draft)

  sentAt     DateTime?
  expiresAt  DateTime? // sentAt + QUOTE_VALIDITY_DAYS; null until sent
  viewedAt   DateTime? // First visit to /quote/{token}
  acceptedAt DateTime? // Set by the webhook when the deposit is paid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lead the quote was written for (optional: the customer may not be in Contacts yet)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // The project created from this quote once the deposit is paid
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([email])
  @@index([status])
  @@index([contactId])
  @@index([createdAt])
}

// One row per charge of a project: the deposit and the final payment.
model Payment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind   PaymentKind
  amount Int // In cents
  status PaymentStatus @default(pending)

  stripeSessionId String?   @unique // Checkout Session that paid this charge
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, kind])
  @@index([status])
  @@index([paidAt])
}

model TermsAcceptance {
  id             String   @id @default(cuid())
  userId         String?
  projectId      String?  @unique // 50/50 projects
  subscriptionId String?  @unique // subscriptions
  plan           String?
  acceptedAt     DateTime
  ipAddress      String?
  userAgent      String?
  termsVersion   String

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String @id @default(uuid())
  stripeSubscriptionId String @unique
  stripeCustomerId     String
  email                String
  name                 String
  planName             String
  amount               Int // Amount in cents ($200 = 20000)
  currency             String @default("USD")

  // Status
  status SubscriptionStatus @default(active)

  // Billing cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Cancellation
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  // Stripe session/checkout info
  stripeSessionId String?

  // Magic link to the Stripe Customer Portal (/manage-subscription/[token]).
  // Regenerated on every request; the Stripe session is created on click.
  portalToken          String?   @unique
  portalTokenExpiresAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  termsAcceptance TermsAcceptance?

  @@index([email])
  @@index([stripeCustomerId])
  @@index([status])
}

model SmsLog {
  id          String   @id @default(uuid())
  phoneNumber String
  message     String   @db.Text
  direction   String // received, sent
  command     String? // START, STOP, HELP, etc.
  status      String? // queued, sent, delivered, failed
  twilioSid   String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([direction])
  @@index([createdAt])
}

enum ContactChannel {
  call
  whatsapp
  email
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROPOSAL_SENT
  WON
  LOST
}

enum ProjectStatus {
  pending
  in_progress
  ready_for_payment
  completed
}

enum QuoteStatus {
  draft
  sent
  accepted
  cancelled
}

enum PaymentKind {
  deposit
  final
}

enum PaymentStatus {
  pending
  paid
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  unpaid
}

enum InvoiceType {
  initial
  final
  summary
}

enum InvoiceStatus {
  paid
  pending
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
}

// Project Milestones for tracking detailed progress
model Milestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String // "Design Mockups", "Frontend Development", etc.
  description String?         @db.Text
  order       Int             @default(0) // For sorting milestones
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  completedAt DateTime?
  // When the customer was emailed about this milestone being completed
  notifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([order])
}

model Invoice {
  id            String  @id @default(uuid())
  invoiceNumber String  @unique // "INV-2025-001"
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type InvoiceType

  // Datos del cliente (snapshot histórico)
  customerName  String
  customerEmail String
  projectCode   String // Denormalizado para fácil búsqueda
  planName      String

  // Detalles financieros (en centavos)
  description String @db.Text
  subtotal    Int // Subtotal en centavos
  taxRate     Float  @default(0) // Porcentaje de impuestos (ej: 8.5 para 8.5%)
  taxAmount   Int    @default(0) // Monto de impuestos en centavos
  total       Int // Total final en centavos (subtotal + tax)
  currency    String @default("USD")

  // Almacenamiento del PDF
  pdfUrl     String? // URL en Vercel Blob
  pdfBlobKey String? // Key para eliminar de Vercel Blob si es necesario

  // Metadata de Stripe
  stripeSessionId String?

  // Status y fechas
  status    InvoiceStatus @default(paid)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  paidDate  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([customerEmail])
  @@index([projectCode])
  @@index([status])
  @@index([issueDate])
}

// Google Search Console (etapa 6d): copia diaria de Search Analytics de
// sc-domain:rcweb.dev. La API solo guarda 16 meses; aquí queda para siempre.
// Se rellena con el cron /api/cron/search-console (ver src/lib/searchConsole/).
model SearchConsoleDaily {
  date        DateTime @id @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  syncedAt    DateTime @updatedAt
}

// Top consultas y páginas de cada día (hasta SEARCH_CONSOLE_ROW_LIMIT por
// dimensión). Sumando por key sobre un rango se obtiene el top del periodo.
model SearchConsoleTopItem {
  id          String                 @id @default(uuid())
  date        DateTime               @db.Date
  dimension   SearchConsoleDimension
  key         String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  syncedAt    DateTime               @updatedAt

  @@unique([date, dimension, key])
  @@index([dimension, date])
}

enum SearchConsoleDimension {
  QUERY
  PAGE
}

// Google Business Profile (etapa 6e): copia de las reseñas reales del perfil
// «RC WEB Solutions LLC», traída por el cron /api/cron/google-reviews (ver
// src/lib/googleReviews/). La home y el JSON-LD leen de aquí, nunca de la API.
model GoogleReview {
  id               String    @id // reviewId de Google
  reviewerName     String
  reviewerPhotoUrl String?
  isAnonymous      Boolean   @default(false)
  rating           Int // 1-5
  comment          String? // null = reseña solo con estrellas
  replyComment     String?
  replyTime        DateTime?
  createTime       DateTime
  updateTime       DateTime
  hidden           Boolean   @default(false) // el admin la oculta del sitio
  syncedAt         DateTime  @updatedAt

  @@index([hidden, createTime])
}

// Fila única (id = 1) con la nota media y el total que devuelve la API.
model GoogleReviewSummary {
  id               Int      @id @default(1)
  averageRating    Float
  totalReviewCount Int
  syncedAt         DateTime @updatedAt
}
